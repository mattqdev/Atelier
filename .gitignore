.DS_Store
# Placet local server discovery file (port + secret token)
.placet/
# Projects stay local: the repo holds only the program + the example project
projects/*
!projects/example/
# Python bytecode
__pycache__/
# Rendered reels/videos stay local
reels/
# Exports kept by atelier.py stay local
projects/*/exports/
# Canvas thumbnails rendered by atelier.py stay local
projects/*/.thumbs/
